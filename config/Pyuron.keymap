#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <mouse-gesture.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>


#define MOUSE 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&zip_mouse_gesture {
    stroke-size = <300>;
    enable-eager-mode;
    suppress-movement;
    idle-timeout-ms = <150>;
    gesture-cooldown-ms = <500>;

    gesture_forward {
        pattern = <GESTURE_RIGHT>;
        bindings = <&kp C_AC_FORWARD>;
    };

    gesture_back {
        pattern = <GESTURE_LEFT>;
        bindings = <&kp C_AC_BACK>;
    };

    gesture_zoom_in {
        pattern = <GESTURE_UP>;
        bindings = <&kp LG(PLUS)>;
    };

    gesture_zoom_out {
        pattern = <GESTURE_DOWN>;
        bindings = <&kp LG(MINUS)>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        // F + E → 左クリック
        combo_left_click_1 {
            timeout-ms = <50>;
            key-positions = <13 2>;
            bindings = <&mkp LCLK>;
        };

        // J + I → 左クリック
        combo_left_click_2 {
            timeout-ms = <50>;
            key-positions = <16 7>;
            bindings = <&mkp LCLK>;
        };

        // W + A → 右クリック
        combo_right_click_1 {
            timeout-ms = <50>;
            key-positions = <1 10>;
            bindings = <&mkp RCLK>;
        };

        // O + ' → 右クリック
        combo_right_click_2 {
            timeout-ms = <50>;
            key-positions = <8 19>;
            bindings = <&mkp RCLK>;
        };

        // W + E → 左トラックボールをスクロール
        combo_scroll_left {
            timeout-ms = <50>;
            key-positions = <1 2>;
            bindings = <&mo 11>;
        };

        // I + O → 右トラックボールをスクロール
        combo_scroll_right {
            timeout-ms = <50>;
            key-positions = <7 8>;
            bindings = <&mo 12>;
        };

        // S + D → 中クリック
        combo_middle_click_1 {
            timeout-ms = <50>;
            key-positions = <11 12>;
            bindings = <&mkp MCLK>;
        };

        // K + L → 中クリック
        combo_middle_click_2 {
            timeout-ms = <50>;
            key-positions = <17 18>;
            bindings = <&mkp MCLK>;
        };

        // 左親指2キー → レイヤー9
        combo_left_thumb_layer {
            timeout-ms = <50>;
            key-positions = <34 35>;
            bindings = <&mo 9>;
        };

        // 右親指2キー → レイヤー10
        combo_right_thumb_layer {
            timeout-ms = <50>;
            key-positions = <36 37>;
            bindings = <&mo 10>;
        };

        // D + W → 左クリック
        combo_left_click_3 {
            timeout-ms = <50>;
            key-positions = <12 1>;
            bindings = <&mkp LCLK>;
        };

        // K + O → 左クリック
        combo_left_click_4 {
            timeout-ms = <50>;
            key-positions = <17 8>;
            bindings = <&mkp LCLK>;
        };

        // Q + W → 左トラックボールをスクロール
        combo_scroll_left_2 {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&mo 11>;
        };

        // O + P → 右トラックボールをスクロール
        combo_scroll_right_2 {
            timeout-ms = <50>;
            key-positions = <8 9>;
            bindings = <&mo 12>;
        };

        // 左下外側2キー → 左トラックボールをスクロール
        combo_scroll_left_3 {
            timeout-ms = <50>;
            key-positions = <32 33>;
            bindings = <&mo 11>;
        };

        // 右下外側2キー → 右トラックボールをスクロール
        combo_scroll_right_3 {
            timeout-ms = <50>;
            key-positions = <38 39>;
            bindings = <&mo 12>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    lt_to_layer_0: lt_to_layer_0 {
        compatible = "zmk,behavior-hold-tap";
        label = "LAYER_TAP_TO_0";
        bindings = <&mo>, <&to_layer_0>;

        #binding-cells = <2>;
        tapping-term-ms = <200>;
    };
};

/ {
    behaviors {
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&mouse_gesture_kp 0 Q  &kp W      &kp E      &kp R         &kp T           &kp Y        &kp U          &kp I        &kp O              &mouse_gesture_kp 0 P
&kp A             &kp S      &kp D      &kp F         &kp G           &kp H        &kp J          &kp K        &kp L              &kp SQT
&mt LEFT_SHIFT Z  &kp X      &kp C      &kp V         &kp B           &lt 4 COLON  &kp BACKSLASH  &kp N        &kp M              &kp COMMA
&kp DOT           &kp SLASH  &kp LCTRL  &kp LEFT_WIN  &lt 2 LEFT_ALT  &lt 3 SPACE  &kp BACKSPACE  &lt 1 ENTER  &kp RIGHT_CONTROL  &kp DEL
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans   &trans  &trans  &trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5
&trans  &trans   &trans  &trans  &trans  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
&trans  &trans   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp F11  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp F12
            >;
        };

        layer_2 {
            bindings = <
&kp MINUS                   &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PLUS      &kp CARET        &kp AMPERSAND  &kp TILDE         &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp SLASH                   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ASTERISK  &kp EXCLAMATION  &kp AT_SIGN    &kp HASH          &kp DOLLAR            &kp PERCENT
&mt LEFT_SHIFT KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD    &kp EQUAL        &trans         &kp LEFT_BRACKET  &kp RIGHT_BRACKET     &kp LEFT_BRACE
&kp RIGHT_BRACE             &kp BACKSLASH    &trans           &trans           &trans        &trans           &trans         &trans            &trans                &kp PIPE
            >;
        };

        layer_3 {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans   &trans  &trans  &trans  &trans  &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans  &trans  &trans  &trans  &trans
&trans          &trans                  &trans          &trans                   &trans   &trans  &trans  &trans  &trans  &trans
            >;
