#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <mouse-gesture.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <input/processors.dtsi>


&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&zip_temp_layer {
    excluded-positions =
        <1 2 3 6 7 8
         10 11 12 13 16 17 18 19
         20 23 28 31 34 37>;
};

&mkp_input_listener {
    input-processors = <&zip_temp_layer 13 0>;
};

&zip_mouse_gesture {
    stroke-size = <300>;
    enable-eager-mode;
    suppress-movement;
    idle-timeout-ms = <150>;
    gesture-cooldown-ms = <500>;

    gesture_forward {
        pattern = <GESTURE_RIGHT>;
        bindings = <&kp LG(RBKT)>;
    };

    gesture_back {
        pattern = <GESTURE_LEFT>;
        bindings = <&kp LG(LBKT)>;
    };

    gesture_zoom_in {
        pattern = <GESTURE_UP>;
        bindings = <&kp LG(PLUS)>;
    };

    gesture_zoom_out {
        pattern = <GESTURE_DOWN>;
        bindings = <&kp LG(MINUS)>;
    };
};



/ {
mouse_gesture_window: mouse_gesture_window {
    compatible = "zmk,input-processor-mouse-gesture";
    #input-processor-cells = <0>;

    stroke-size = <300>;
    enable-eager-mode;
    suppress-movement;
    idle-timeout-ms = <150>;
    gesture-cooldown-ms = <500>;

    gesture_right {
        pattern = <GESTURE_RIGHT>;
        bindings = <&kp LG(RIGHT)>;
    };

    gesture_left {
        pattern = <GESTURE_LEFT>;
        bindings = <&kp LG(LEFT)>;
    };

    gesture_up {
        pattern = <GESTURE_UP>;
        bindings = <&kp LG(UP)>;
    };

    gesture_down {
        pattern = <GESTURE_DOWN>;
        bindings = <&kp LG(DOWN)>;
    };
};

mouse_gesture_apple: mouse_gesture_apple {
    compatible = "zmk,input-processor-mouse-gesture";
    #input-processor-cells = <0>;

    stroke-size = <300>;
    enable-eager-mode;
    suppress-movement;
    idle-timeout-ms = <150>;
    gesture-cooldown-ms = <500>;

    gesture_right {
        pattern = <GESTURE_RIGHT>;
        bindings = <&kp LG(RBKT)>;
    };

    gesture_left {
        pattern = <GESTURE_LEFT>;
        bindings = <&kp LG(LBKT)>;
    };

    gesture_up {
        pattern = <GESTURE_UP>;
        bindings = <&kp LG(PLUS)>;
    };

    gesture_down {
        pattern = <GESTURE_DOWN>;
        bindings = <&kp LG(MINUS)>;
    };
};

ctrl_scroll_left: ctrl_scroll_left {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    wait-ms = <0>;

    bindings =
        <&macro_press &kp LCTRL>,
        <&macro_press &mo 11>,
        <&macro_pause_for_release>,
        <&macro_release &mo 11>,
        <&macro_release &kp LCTRL>;
};

ctrl_scroll_right: ctrl_scroll_right {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    wait-ms = <0>;

    bindings =
        <&macro_press &kp LCTRL>,
        <&macro_press &mo 12>,
        <&macro_pause_for_release>,
        <&macro_release &mo 12>,
        <&macro_release &kp LCTRL>;
};


    combos {
        compatible = "zmk,combos";

        // F + E → 左クリック
        combo_left_click_1 {
            timeout-ms = <50>;
            key-positions = <13 2>;
            bindings = <&mkp LCLK>;
        };

        // J + I → 左クリック
        combo_left_click_2 {
            timeout-ms = <50>;
            key-positions = <16 7>;
            bindings = <&mkp LCLK>;
        };

        // W + A → 右クリック
        combo_right_click_1 {
            timeout-ms = <50>;
            key-positions = <1 10>;
            bindings = <&mkp RCLK>;
        };

        // O + ' → 右クリック
        combo_right_click_2 {
            timeout-ms = <50>;
            key-positions = <8 19>;
            bindings = <&mkp RCLK>;
        };

        // W + E → 左トラックボールをスクロール
        combo_scroll_left {
            timeout-ms = <50>;
            key-positions = <1 2>;
            bindings = <&mo 11>;
        };

        // I + O → 右トラックボールをスクロール
        combo_scroll_right {
            timeout-ms = <50>;
            key-positions = <7 8>;
            bindings = <&mo 12>;
        };

// S + D → Ctrl + 左トラックボールスクロール
combo_ctrl_scroll_left {
    timeout-ms = <50>;
    key-positions = <11 12>;
    bindings = <&ctrl_scroll_left>;
};

// K + L → Ctrl + 右トラックボールスクロール
combo_ctrl_scroll_right {
    timeout-ms = <50>;
    key-positions = <17 18>;
    bindings = <&ctrl_scroll_right>;
};

        // 左親指2キー → レイヤー9
        combo_left_thumb_layer {
            timeout-ms = <50>;
            key-positions = <34 35>;
            bindings = <&mo 9>;
        };

        // 右親指2キー → レイヤー10
        combo_right_thumb_layer {
            timeout-ms = <50>;
            key-positions = <36 37>;
            bindings = <&mo 10>;
        };

        // D + W → 左クリック
        combo_left_click_3 {
            timeout-ms = <50>;
            key-positions = <12 1>;
            bindings = <&mkp LCLK>;
        };

        // K + O → 左クリック
        combo_left_click_4 {
            timeout-ms = <50>;
            key-positions = <17 8>;
            bindings = <&mkp LCLK>;
        };

        // Q + W → 左トラックボールをスクロール
        combo_scroll_left_2 {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&mo 11>;
        };

        // O + P → 右トラックボールをスクロール
        combo_scroll_right_2 {
            timeout-ms = <50>;
            key-positions = <8 9>;
            bindings = <&mo 12>;
        };

        // 左下外側2キー → 左トラックボールをスクロール
        combo_scroll_left_3 {
            timeout-ms = <50>;
            key-positions = <32 33>;
            bindings = <&mo 11>;
        };

        // 右下外側2キー → 右トラックボールをスクロール
        combo_scroll_right_3 {
            timeout-ms = <50>;
            key-positions = <38 39>;
            bindings = <&mo 12>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

ctrl_mb1_hold: ctrl_mb1_hold {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    wait-ms = <0>;
    bindings =
        <&macro_press &mo 13>,
        <&macro_press &kp LCTRL>,
        <&macro_wait_time 30>,
        <&macro_press &mkp MB1>,
        <&macro_pause_for_release>,
        <&macro_release &mkp MB1>,
        <&macro_wait_time 50>,
        <&macro_release &kp LCTRL>,
        <&macro_release &mo 13>;
};

